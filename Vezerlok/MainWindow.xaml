<Window x:Class="Vezerlok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vezerlok"
        mc:Ignorable="d"
        Title="Vezérlők" Height="900" Width="800" MinWidth="650" MinHeight="700">
    <DockPanel  TextElement.FontWeight="Bold"   >
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Fájl">
                <MenuItem Header="Megnyitás"></MenuItem>
                <MenuItem Header="Mentés"></MenuItem>
                <MenuItem Header="Kilépés"></MenuItem>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Nézet"></MenuItem>
            <MenuItem Header="Súgó"></MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom" Height="44" RenderTransformOrigin="0.515,7.908" Width="1920">
            <Label Content="Kész: "></Label>
            <ProgressBar Value="40" Height="20" Width="100"></ProgressBar>
        </StatusBar>
        <Grid>
            <Grid.RowDefinitions>
                <!--Az 1* a hely felosztására szolgál-->
                    <RowDefinition Height="1*"></RowDefinition>
                <RowDefinition Height="1*"></RowDefinition>
                <RowDefinition Height="1*"></RowDefinition>
            </Grid.RowDefinitions>
            
            <!--AlAP-->
            <GroupBox Grid.Row="0" Header="Alap vezérlők: ">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>  
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="5">
                        <Label Content="Név: "/>
                        <Label Content="Jelszó: "/>
                        <CheckBox x:Name="Cookies" Content="Felhasználói feltételek elfogadása"/>
                        <StackPanel x:Name="Nem" Orientation="Horizontal" Margin="5">
                            <RadioButton x:Name="Ferfi" GroupName="nem" Content="Férfi" Margin="5"/>
                            <RadioButton x:Name="No" GroupName="nem" Content="Nő" Margin="5"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBox x:Name="Nev" Width="200" Height="20" Margin="5"/>
                        <PasswordBox x:Name="Jelszo" Width="200" Height="20" Margin="5"/>
                        <Button x:Name="Kuldes" Content="Küldés" Margin="50"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
            <!--LISTA-->
            
            <GroupBox Grid.Row="1" Header="Lista vezérlők: ">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!--Lisbox-->
                        <StackPanel Grid.Column="0">
                        <Label Content="Listbox" Margin="5"/>
                        <ListBox Margin="5">
                            <ListBox.Items>
                                <ListBoxItem Content="Alma"/>
                                <ListBoxItem Content="Körte"/>
                                <ListBoxItem Content="Banán"/>
                            </ListBox.Items>
                        </ListBox>
                    </StackPanel>
                    <!--Combobox-->
                    <StackPanel Grid.Column="1">
                        <Label Content="Combobox:" Margin="5"/>
                        <ComboBox Width="150" Margin="5">
                            <ComboBoxItem Content="Téli"/>
                            <ComboBoxItem Content="Tavaszi"/>
                            <ComboBoxItem Content="Nyári"/>
                            <ComboBoxItem Content="Őszi"/>
                        </ComboBox>
                        <Label Content="Slider:" Margin="5"/>
                        <Slider Minimum="0" Maximum="100" Value="50" Width="150"></Slider>
                    </StackPanel>
                    <!--ProgressBar-->
                    <StackPanel Grid.Column="2">
                        <Label Content="ProgressBar:" Margin="5"/>
                        <ProgressBar Width="150" Value="80" Height="20" Margin="5"/>
                        <Label Content="image:" Margin="5"/>
                        <Image Source="C:\Users\Gombosb\source\repos\Vezerlok\Vezerlok\Névtelen.png" Width="200" Height="130"></Image>
                    </StackPanel>
                </Grid>
            </GroupBox>
            
            <!--HALADÓ-->
            <GroupBox Grid.Row="2" Header="Haladó Elemek: ">
                <Grid Margin="5">
                    
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
